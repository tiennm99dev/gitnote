<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup on Android 11 and older. Tokens are encrypted with a Keystore key
     that a new device does not get, so a restored copy could never be read. -->
<full-backup-content>
    <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
</full-backup-content>
