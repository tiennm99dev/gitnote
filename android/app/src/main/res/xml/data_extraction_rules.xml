<?xml version="1.0" encoding="utf-8"?>
<!-- Backups on Android 12 and newer. Tokens are encrypted with a Keystore key that
     a new device does not get, so a restored copy could never be read. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
