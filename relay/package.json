{
  "name": "@gitnote/relay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "types": "mkdir -p .wrangler/types && wrangler types .wrangler/types/worker-configuration.d.ts",
    "check": "npm run types && tsc -p jsconfig.json"
  },
  "dependencies": {
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  }
}
